{
  "name": "newsbeat-worker",
  "version": "0.2.0",
  "description": "NewsBeat ingestion worker: Google News RSS and optional NewsAPI.ai, filtering, normalization and storage.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "ingest": "tsx src/cli.ts"
  },
  "dependencies": {
    "@newsbeat/contracts": "0.2.0",
    "@newsbeat/db": "0.2.0",
    "zod": "^3.24.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
