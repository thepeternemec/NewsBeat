{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/status",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/intelligence",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/market-intelligence",
      "schedule": "1-59/5 * * * *"
    },
    {
      "path": "/api/cron/priority-news",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/telegram",
      "schedule": "0 9 * * *"
    }
  ],
  "buildCommand": "cd ../.. && npm run build"
}
