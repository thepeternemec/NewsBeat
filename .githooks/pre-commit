#!/bin/sh
#
# Type-check before committing.
#
# Twice in one session a build was run with its output redirected to /dev/null.
# Both times it failed, both times nothing said so, and the next thing run was
# tested against a stale compiled artifact.
#
# It also caught only `packages` for a while, which is how an API syntax error
# reached `main`: the hook built the contracts and the db, called it clean, and
# the broken route shipped. A build's output is the only thing that tells you it
# failed, and the thing that failed has to be the thing that is built.

if ! out=$(npm run build:packages 2>&1 && npm run build -w @newsbeat/api 2>&1); then
  echo ""
  echo "$out" | grep -E "error TS|Error:" | head -10
  echo ""
  echo "  refusing to commit: the workspace does not compile."
  echo "  Fix the error above, or commit with --no-verify to skip this check."
  echo ""
  exit 1
fi
