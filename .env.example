# NewsBeat development configuration
# Setup: docs/DEVELOPMENT.md
# For Next.js, copy this file to apps/web/.env.local.
# Standalone Node scripts need --env-file=apps/web/.env.local.
# Never commit a populated environment file.

# Required for local news data
DATABASE_URL=
# Stable random value for signed article cursors; rotating it resets cursors.
NEWSBEAT_CURSOR_SECRET=

# Collection defaults to Google News RSS; no provider key is needed.
# Set NEWSBEAT_PROVIDER=newsapi only when using your own NewsAPI.ai account.
NEWSBEAT_PROVIDER=
NEWSAPI_API_KEY=
NEWSBEAT_CONCURRENCY=

# Optional model generation outside Vercel. Model use consumes provider credits.
# Vercel deployments can use their server-side OIDC identity instead.
AI_GATEWAY_API_KEY=

# Optional scheduled pilot analysis and market-worker bearer secret.
CRON_SECRET=
# Existing general-ingestion route's separate manual-run secret.
NEWSBEAT_CRON_SECRET=

# Optional browser API origin; blank uses same-origin /api.
# Only public configuration belongs in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_BASE_URL=

# Optional GitHub OAuth for account keys.
# Callback: <origin>/api/keys/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional GitHub Marketplace webhook secret; see docs/GITHUB-MARKETPLACE.md.
GITHUB_MARKETPLACE_WEBHOOK_SECRET=

# Optional Rarebird Telegram group. Store the token and webhook secret server-side.
NEWSBEAT_TELEGRAM_BOT_TOKEN=
NEWSBEAT_TELEGRAM_WEBHOOK_SECRET=
NEWSBEAT_TELEGRAM_BOT_USERNAME=
NEWSBEAT_TELEGRAM_CHAT_ID=
NEWSBEAT_TELEGRAM_TOPIC_ID=
# Up to three comma-separated tickers for the 09:00 UTC group feed.
NEWSBEAT_TELEGRAM_FEED_TICKERS=
