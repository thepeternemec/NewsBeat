# ── NewsGraph environment ───────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# ── Required ────────────────────────────────────────────────────────────
# A Postgres connection string. Any Postgres works — Vercel Postgres (Neon),
# plain Neon, RDS, or a local container. Create the schema with:
#   npm run db:setup
DATABASE_URL=

# Signs the article cursors. Rotating it invalidates every cursor already
# issued, so treat it as long-lived. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWSGRAPH_CURSOR_SECRET=

# newsapi.ai (Event Registry). Full-access key — the worker reads articles.
# Only needed for NEWSGRAPH_PROVIDER=newsapi. Google News is the default and needs no key.
NEWSAPI_API_KEY=
NEWSGRAPH_PROVIDER=
NEWSGRAPH_CONCURRENCY=

# ── Optional ────────────────────────────────────────────────────────────
# Required for Vercel Cron: Vercel sends Authorization: Bearer $CRON_SECRET.
# User-Agent is not authentication. Legacy/manual secret remains accepted for ingestion.
CRON_SECRET=
#   curl -H "Authorization: Bearer $NEWSGRAPH_CRON_SECRET" \
#        https://newsgraph.vercel.app/api/cron/ingest
NEWSGRAPH_CRON_SECRET=

# Override the API base the site calls. Default is same-origin "/api".
NEXT_PUBLIC_API_BASE_URL=

# ── Self-serve keys (optional) ──────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers, set its
# callback URL to <origin>/api/keys/callback, and paste both values here.
# Without them, /api/keys/authorize says so plainly and keys are issued by hand
# with `npm run key:issue`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts webhook signing secrets at rest. Random, at least 32 characters. Keep stable.
NEWSGRAPH_WEBHOOK_SECRET=
# Optional hosted OAuth 2.1 authorization server; see docs/INTEGRATIONS.md.
NEWSGRAPH_OAUTH_ISSUER=
NEWSGRAPH_OAUTH_JWKS_URL=
NEWSGRAPH_OAUTH_RESOURCE=
NEWSGRAPH_REQUIRE_MCP_AUTH=false
# Additional exact browser origins; no wildcards.
NEWSGRAPH_MCP_ORIGINS=
