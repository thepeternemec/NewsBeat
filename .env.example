# ── NewsBeat environment ───────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# ── Required ────────────────────────────────────────────────────────────
# A Postgres connection string. Any Postgres works — Vercel Postgres (Neon),
# plain Neon, RDS, or a local container. Create the schema with:
#   npm run db:setup
DATABASE_URL=

# Signs the article cursors. Rotating it invalidates every cursor already
# issued, so treat it as long-lived. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWSBEAT_CURSOR_SECRET=

# newsapi.ai (Event Registry). Full-access key — the worker reads articles.
# Only needed for NEWSBEAT_PROVIDER=newsapi. Google News is the default and needs no key.
NEWSAPI_API_KEY=
NEWSBEAT_PROVIDER=
NEWSBEAT_CONCURRENCY=

# ── Optional ────────────────────────────────────────────────────────────
# Shared secret for a manual ingestion run. Vercel Cron requests are signed by
# the platform and do not need it.
#   curl -H "Authorization: Bearer $NEWSBEAT_CRON_SECRET" \
#        https://www.newsbeat.dev/api/cron/ingest
NEWSBEAT_CRON_SECRET=

# Override the API base the site calls. Default is same-origin "/api".
NEXT_PUBLIC_API_BASE_URL=

# ── Self-serve keys (optional) ──────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers, set its
# callback URL to <origin>/api/keys/callback, and paste both values here.
# Without them, /api/keys/authorize says so plainly and keys are issued by hand
# with `npm run key:issue`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Marketplace listing webhook (separate from the OAuth client secret).
# Set the identical high-entropy value in the Marketplace webhook Secret field.
# See docs/GITHUB-MARKETPLACE.md. Never use a NEXT_PUBLIC_ variable.
GITHUB_MARKETPLACE_WEBHOOK_SECRET=
